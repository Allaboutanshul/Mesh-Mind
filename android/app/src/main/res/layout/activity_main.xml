<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ══════════════════════════════════════════════════ -->
        <!-- HEADER BANNER                                      -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0284C7"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#BAE6FD"
                    android:layout_marginRight="5dp" />
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#BAE6FD"
                    android:layout_marginRight="5dp" />
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FFF"
                    android:layout_marginRight="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MESHMIND"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Emergency Mesh System"
                android:textColor="#BAE6FD"
                android:textSize="13sp"
                android:letterSpacing="0.04"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device:"
                android:textColor="#BAE6FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android Device"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Node ID:"
                android:textColor="#BAE6FD"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/chip_bg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_green"
                    android:layout_marginRight="6dp" />

                <TextView
                    android:id="@+id/localNodeIdText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NODE-..."
                    android:textColor="#E0F2FE"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- STATUS BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Initializing Offline Mesh Radios…"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        
        <!-- GATEWAY CONFIGURATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="1dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gateway IP Setting"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <EditText
                    android:id="@+id/gatewayIpInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Enter PC Gateway IP (e.g. 192.168.1.5)"
                    android:textColor="#0F172A"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="13sp"
                    android:singleLine="true" />
                    
                <Button
                    android:id="@+id/btnSaveGateway"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#0284C7"
                    android:text="SAVE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>
        </LinearLayout>
        
        <!-- TRANSPORT SELECTOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="1dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transport Mode"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/transportRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <RadioButton
                    android:id="@+id/radioNearby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby (Auto)"
                    android:textSize="13sp"
                    android:checked="true"
                    android:buttonTint="#0284C7"
                    android:layout_marginRight="16dp"/>
                    
                <RadioButton
                    android:id="@+id/radioBluetooth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth Only (Strict)"
                    android:buttonTint="#0284C7"
                    android:textSize="13sp"/>
            </RadioGroup>
        </LinearLayout>

        <!-- PERMISSION WARNING BANNER -->
        <TextView
            android:id="@+id/permissionBannerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEF3C7"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="⚠  Bluetooth / Location permissions needed for mesh discovery"
            android:textColor="#92400E"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ══════════════════════════════════════════════════ -->
        <!-- FEATURE 1: ONE-TAP EMERGENCY SOS CARD              -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FEF2F2"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISASTER EMERGENCY RESPONSE"
                android:textColor="#991B1B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <!-- PROMINENT ONE-TAP SOS BUTTON -->
            <Button
                android:id="@+id/sosButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#DC2626"
                android:text="🚨 ONE-TAP EMERGENCY SOS"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:elevation="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Broadcasting an SOS alerts all nearby mesh nodes and rescue hubs with your Node ID and Location."
                android:textColor="#7F1D1D"
                android:textSize="11sp"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal" />

            <!-- SOS TRANSMISSION STATUS CARD -->
            <LinearLayout
                android:id="@+id/sosStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="14dp"
                android:elevation="1dp">

                <TextView
                    android:id="@+id/sosStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOS Status: Ready (No active SOS)"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sosDetailsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location: Capturing offline GPS coordinates…"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- FEATURE 2: OFFLINE AI EMERGENCY ASSISTANT CARD    -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:elevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OFFLINE EMERGENCY ASSISTANT"
                    android:textColor="#0284C7"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE MODE — No Internet required"
                    android:textColor="#047857"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="#D1FAE5"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick-Action Disaster Protocols:"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- QUICK-ACTION BUTTONS ROW 1 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuickTrapped"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🧱 Trapped in Debris"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnQuickSmoke"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🔥 Smoke / Fire"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnQuickBleeding"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🩸 Bleeding Wound"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnQuickEarthquake"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="🌊 Earthquake"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnQuickBattery"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="⚡ Conserve Battery"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnQuickSignal"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="📣 Signal Rescuers"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- CUSTOM QUERY INPUT ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/assistantQueryInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Ask offline assistant (e.g. 'I cannot find the exit')"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="13sp"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/assistantAskButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#0284C7"
                    android:text="ASK"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>

            <!-- ASSISTANT RESPONSE DISPLAY CARD -->
            <LinearLayout
                android:id="@+id/assistantResponseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F8FAFC"
                android:padding="14dp"
                android:elevation="1dp">

                <TextView
                    android:id="@+id/assistantResponseSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Tap a quick-action button or type an emergency question above."
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/assistantResponseStepsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- CONNECTED PEERS CARD                               -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTED MESH PEERS"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/connectedNodesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No MeshMind nodes found nearby"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/refreshButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#F1F5F9"
                android:text="Refresh / Rescan"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold"
                android:elevation="1dp" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- BROADCAST GENERAL TEXT MESSAGE CARD                 -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BROADCAST GENERAL TEXT MESSAGE"
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_bg"
                android:hint="Type custom message to broadcast…"
                android:textColorHint="#94A3B8"
                android:textColor="#0F172A"
                android:padding="12dp"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#0284C7"
                android:text="BROADCAST TEXT TO MESH"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.05"
                android:elevation="2dp" />
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- REAL-TIME MESH LOG CARD                             -->
        <!-- ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REAL-TIME MESH LOG"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="#F8FAFC"
                android:padding="10dp">

                <TextView
                    android:id="@+id/messageLogText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MeshMind node ready…\nWaiting for mesh messages…"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
